<?xml version="1.0" encoding="utf-8"?>
<!-- Restore from nuget.org only (ignores machine-wide/corporate feeds for this repo). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
